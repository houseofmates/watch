# env overrides (all optional — built-in defaults in settings_repo.dart will be used if a var is empty)
# copy this file to .env and set your actual paths

# Local media roots (used by the watch server on Linux desktop)
WATCH_SHOWS_ROOT=/mnt/nextcloud/house/files/media/shows
WATCH_MOVIES_ROOT=/mnt/nextcloud/house/files/media/movies
WATCH_PORN_ROOT=/mnt/nextcloud/house/files/media/porn

# Jellyseerr API (for the discover page)
# On web, requests are proxied through the watch server so this can be a relative path.
# On native (Linux/Android APK), set the full URL to your Jellyseerr instance.
JELLYSEERR_API_URL=http://192.168.4.233:5055
JELLYSEERR_API_KEY=***
# Optional: set JELLYSEERR_COOKIE to a connect.sid session cookie if your instance
# requires session-based auth (not just API key) for discover/search endpoints.
# After logging into Jellyseerr in your browser, copy the connect.sid cookie value
# from your browser's dev tools (Application → Cookies) and paste it here.
# JELLYSEERR_COOKIE=connect.sid=s%3A...
JELLYSEERR_COOKIE=

# TMDb API key (optional) — free key from https://www.themoviedb.org/settings/api
# Used by the watch server to look up movie/show poster thumbnails
TMDB_API_KEY=
